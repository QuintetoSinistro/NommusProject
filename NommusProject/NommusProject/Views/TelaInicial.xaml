<Window x:Class="Nommus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nommus - Controle Financeiro" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        MouseMove="Window_MouseMove">

    <Window.Resources>
        <!-- Styles (mantidos iguais) -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="20"
                                Margin="8,4">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E293B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                BorderBrush="#334155"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PopupButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                BorderBrush="#334155"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar (mantido igual) -->
        <Border Grid.Column="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Row="0" Margin="20,30" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Viewbox Width="40" Height="40">
                        <Canvas Width="24" Height="24">
                            <Path Data="M3,12 L7,8 L11,14 L15,10 L19,16 L21,12" 
                                  Stroke="#3B82F6" StrokeThickness="2"/>
                            <Ellipse Canvas.Left="2" Canvas.Top="11" Width="2" Height="2" Fill="#3B82F6"/>
                            <Ellipse Canvas.Left="6" Canvas.Top="7" Width="2" Height="2" Fill="#3B82F6"/>
                            <Ellipse Canvas.Left="10" Canvas.Top="13" Width="2" Height="2" Fill="#3B82F6"/>
                            <Ellipse Canvas.Left="14" Canvas.Top="9" Width="2" Height="2" Fill="#3B82F6"/>
                            <Ellipse Canvas.Left="18" Canvas.Top="15" Width="2" Height="2" Fill="#3B82F6"/>
                            <Ellipse Canvas.Left="20" Canvas.Top="11" Width="2" Height="2" Fill="#3B82F6"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="Nommus" FontSize="24" FontWeight="Bold" Foreground="#F1F5F9" 
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>

                <!-- Navigation Menu -->
                <StackPanel Grid.Row="1" Margin="10,20">
                    <Button Content="Finanças" Style="{StaticResource SidebarButtonStyle}" Click="FinanceButton_Click">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="24" Height="24" Margin="0,0,12,0">
                                        <Canvas Width="16" Height="16">
                                            <Path Data="M2,2 L14,2 L14,14 L2,14 Z M4,4 L12,4 L12,12 L4,12 Z M6,6 L10,6 L10,10 L6,10 Z" 
                                                  Fill="#3B82F6"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" Foreground="#E2E8F0"/>
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>

                    <Button Content="Cartões" Style="{StaticResource SidebarButtonStyle}" Click="CardsButton_Click">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="24" Height="24" Margin="0,0,12,0">
                                        <Canvas Width="16" Height="16">
                                            <Path Data="M2,4 L14,4 L14,12 L2,12 Z M4,6 L12,6 L12,10 L4,10 Z M6,8 L10,8" 
                                                  Fill="#10B981"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" Foreground="#E2E8F0"/>
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>

                    <Button Content="Gastos" Style="{StaticResource SidebarButtonStyle}" Click="ExpensesButton_Click">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="24" Height="24" Margin="0,0,12,0">
                                        <Canvas Width="16" Height="16">
                                            <Path Data="M8,2 L8,14 M2,8 L14,8" 
                                                  Stroke="#EF4444" StrokeThickness="2"/>
                                            <Path Data="M4,4 L12,12 M12,4 L4,12" 
                                                  Stroke="#EF4444" StrokeThickness="1"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" Foreground="#E2E8F0"/>
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>

                    <Button Content="Créditos" Style="{StaticResource SidebarButtonStyle}" Click="CreditsButton_Click">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="24" Height="24" Margin="0,0,12,0">
                                        <Canvas Width="16" Height="16">
                                            <Path Data="M8,2 L8,14 M2,8 L14,8" 
                                                  Stroke="#F59E0B" StrokeThickness="2"/>
                                            <Path Data="M5,5 L11,11 M11,5 L5,11" 
                                                  Stroke="#F59E0B" StrokeThickness="1"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" Foreground="#E2E8F0"/>
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>

                    <Button Content="Metas" Style="{StaticResource SidebarButtonStyle}" Click="GoalsButton_Click">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="24" Height="24" Margin="0,0,12,0">
                                        <Canvas Width="16" Height="16">
                                            <Path Data="M2,8 L6,12 L14,4" 
                                                  Stroke="#8B5CF6" StrokeThickness="2"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" Foreground="#E2E8F0"/>
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                </StackPanel>

                <!-- User Profile -->
                <Border Grid.Row="2" Background="#334155" Margin="16" CornerRadius="16" Padding="16">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="40" Height="40" Fill="#64748B"/>
                        <StackPanel Margin="12,0,0,0">
                            <TextBlock Text="Usuário" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                            <TextBlock Text="Premium" Foreground="#3B82F6" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Border Grid.Column="1" Background="#0F172A" Padding="30">
            <Grid x:Name="MainGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Background="#1E293B" CornerRadius="12" Padding="20" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Meu Controle Financeiro" 
                                   FontSize="24" FontWeight="Bold" Foreground="#F1F5F9"
                                   VerticalAlignment="Center"/>

                        <!-- Header Icons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource SidebarButtonStyle}" Width="40" Height="40" 
                                    Background="Transparent" Margin="0,0,8,0">
                                <Viewbox Width="20" Height="20">
                                    <Canvas Width="16" Height="16">
                                        <Ellipse Canvas.Left="4" Canvas.Top="2" Width="8" Height="8" Fill="#94A3B8"/>
                                        <Path Data="M2,14 L14,14 L14,16 L2,16 Z" Fill="#94A3B8"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>

                            <Button Style="{StaticResource SidebarButtonStyle}" Width="40" Height="40" 
                                    Background="Transparent" Margin="0,0,8,0">
                                <Viewbox Width="20" Height="20">
                                    <Canvas Width="16" Height="16">
                                        <Path Data="M8,2 L8,2 C10,2 12,4 12,6 L12,10 M8,14 L8,10" 
                                              Stroke="#94A3B8" StrokeThickness="1.5"/>
                                        <Ellipse Canvas.Left="10" Canvas.Top="1" Width="4" Height="4" Fill="#EF4444"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>

                            <Button Style="{StaticResource SidebarButtonStyle}" Width="40" Height="40" 
                                    Background="Transparent">
                                <Viewbox Width="20" Height="20">
                                    <Canvas Width="16" Height="16">
                                        <Ellipse Canvas.Left="4" Canvas.Top="4" Width="8" Height="8" 
                                                 Stroke="#94A3B8" StrokeThickness="1.5" Fill="Transparent"/>
                                        <Path Data="M8,4 L8,0 M8,16 L8,12 M12,8 L16,8 M0,8 L4,8" 
                                              Stroke="#94A3B8" StrokeThickness="1.5"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Balance Card -->
                <Border Grid.Row="1" Background="#1E293B" CornerRadius="12" Padding="25" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Saldo atual" FontSize="14" Foreground="#94A3B8"/>
                            <TextBlock x:Name="BalanceText" Text="R$ 500,45" FontSize="32" FontWeight="Bold" Foreground="#F1F5F9" 
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Botões principais que alternam entre Gastos e Receitas -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="ExpensesMainButton" Content="Gastos" Style="{StaticResource ActionButtonStyle}" 
                                    Click="ExpensesMainButton_Click" Margin="0,0,12,0"/>
                            <Button x:Name="IncomeMainButton" Content="Receitas" Style="{StaticResource ActionButtonStyle}" 
                                    Click="IncomeMainButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Chart Area -->
                <Border Grid.Row="2" Background="#1E293B" CornerRadius="12" Padding="20" Margin="0,0,0,20">
                    <Grid x:Name="ChartGrid">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Evolução Financeira" 
                                   FontSize="18" FontWeight="SemiBold" Foreground="#F1F5F9"
                                   Margin="0,0,0,20"/>

                        <!-- Single Line Chart Container - AGORA OCUPA TODA A LARGURA -->
                        <Border Grid.Row="1" Background="#0F172A" CornerRadius="8" BorderBrush="#334155" BorderThickness="1">
                            <Canvas x:Name="ChartCanvas" Background="Transparent" Height="250"/>
                        </Border>

                        <!-- Pop-up flutuante para Gastos -->
                        <Border x:Name="ExpensesPopup" 
                                Background="#1E293B" 
                                CornerRadius="12" 
                                BorderBrush="#334155" 
                                BorderThickness="1"
                                Padding="20"
                                Width="200"
                                VerticalAlignment="Top"
                                HorizontalAlignment="Left"
                                Visibility="Collapsed"
                                MouseEnter="Popup_MouseEnter"
                                MouseLeave="Popup_MouseLeave">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="4" Opacity="0.3" BlurRadius="10"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="Gastos" FontSize="16" FontWeight="SemiBold" Foreground="#F1F5F9" Margin="0,0,0,15"/>
                                <Button Content="Inserir Novo Gasto" Style="{StaticResource PopupButtonStyle}" 
                                        Click="AddExpenseButton_Click" Margin="0,0,0,8"/>
                                <Button Content="Visualizar Gastos" Style="{StaticResource PopupButtonStyle}" 
                                        Click="ViewExpensesButton_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Pop-up flutuante para Receitas -->
                        <Border x:Name="IncomePopup" 
                                Background="#1E293B" 
                                CornerRadius="12" 
                                BorderBrush="#334155" 
                                BorderThickness="1"
                                Padding="20"
                                Width="200"
                                VerticalAlignment="Top"
                                HorizontalAlignment="Left"
                                Visibility="Collapsed"
                                MouseEnter="Popup_MouseEnter"
                                MouseLeave="Popup_MouseLeave">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="4" Opacity="0.3" BlurRadius="10"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="Receitas" FontSize="16" FontWeight="SemiBold" Foreground="#F1F5F9" Margin="0,0,0,15"/>
                                <Button Content="Inserir Nova Receita" Style="{StaticResource PopupButtonStyle}" 
                                        Click="AddIncomeButton_Click" Margin="0,0,0,8"/>
                                <Button Content="Visualizar Receitas" Style="{StaticResource PopupButtonStyle}" 
                                        Click="ViewIncomeButton_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Quick Actions -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Relatórios" Style="{StaticResource ActionButtonStyle}" 
                            Click="ReportsButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
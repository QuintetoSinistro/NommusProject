<Window x:Class="NommusProject.ConfiguracoesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nommus - Seu Perfil"
        Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0A0F1E" Offset="0"/>
            <GradientStop Color="#1A0533" Offset="0.5"/>
            <GradientStop Color="#2D1052" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Window.Resources>

        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14"
                                Margin="8,4">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E2D5A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#243670"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="brd"
                                Background="Transparent"
                                CornerRadius="10"
                                BorderBrush="#F1F5F9"
                                BorderThickness="1.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="brd" Property="Background" Value="#1E2D5A"/>
                                <Setter TargetName="brd" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="brd" Property="Background" Value="#243670"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AlterarFotoButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Width" Value="160"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="brd"
                                Background="Transparent"
                                CornerRadius="10"
                                BorderBrush="#F1F5F9"
                                BorderThickness="1.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="brd" Property="Background" Value="#1E2D5A"/>
                                <Setter TargetName="brd" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0" Background="#0c0322" BorderBrush="#0c0322" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Row="0" Margin="20,30" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Viewbox Width="40" Height="40">
                        <Canvas Width="24" Height="24">
                            <Path Data="M3,12 L7,8 L11,14 L15,10 L19,16 L21,12" Stroke="#3B82F6" StrokeThickness="2"/>
                            <Ellipse Canvas.Left="2"  Canvas.Top="11" Width="2" Height="2" Fill="#3B82F6"/>
                            <Ellipse Canvas.Left="6"  Canvas.Top="7"  Width="2" Height="2" Fill="#3B82F6"/>
                            <Ellipse Canvas.Left="10" Canvas.Top="13" Width="2" Height="2" Fill="#3B82F6"/>
                            <Ellipse Canvas.Left="14" Canvas.Top="9"  Width="2" Height="2" Fill="#3B82F6"/>
                            <Ellipse Canvas.Left="18" Canvas.Top="15" Width="2" Height="2" Fill="#3B82F6"/>
                            <Ellipse Canvas.Left="20" Canvas.Top="11" Width="2" Height="2" Fill="#3B82F6"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="Nommus" FontSize="24" FontWeight="Bold" Foreground="#F1F5F9" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>

                <!-- Menu -->
                <StackPanel Grid.Row="1" Margin="10,20">

                    <Button Content="Finanças" Style="{StaticResource SidebarButtonStyle}" Click="FinanceButton_Click">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="22" Height="22" Margin="0,0,14,0">
                                        <Canvas Width="16" Height="16">
                                            <Path Data="M2,2 L14,2 L14,14 L2,14 Z M4,4 L12,4 L12,12 L4,12 Z M6,6 L10,6 L10,10 L6,10 Z" Fill="#3B82F6"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" Foreground="#E2E8F0"/>
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>

                    <Button Content="Cartões" Style="{StaticResource SidebarButtonStyle}" Click="CardsButton_Click">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="22" Height="22" Margin="0,0,14,0">
                                        <Canvas Width="16" Height="16">
                                            <Path Data="M2,4 L14,4 L14,12 L2,12 Z M4,6 L12,6 L12,10 L4,10 Z M6,8 L10,8" Fill="#10B981"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" Foreground="#E2E8F0"/>
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>

                    <Button Content="Despesas" Style="{StaticResource SidebarButtonStyle}" Click="ExpensesButton_Click">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="22" Height="22" Margin="0,0,14,0">
                                        <Canvas Width="16" Height="16">
                                            <Path Data="M8,2 L8,14 M2,8 L14,8" Stroke="#EF4444" StrokeThickness="2"/>
                                            <Path Data="M4,4 L12,12 M12,4 L4,12" Stroke="#EF4444" StrokeThickness="1"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" Foreground="#E2E8F0"/>
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>

                    <Button Content="Receitas" Style="{StaticResource SidebarButtonStyle}" Click="CreditsButton_Click">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="22" Height="22" Margin="0,0,14,0">
                                        <Canvas Width="16" Height="16">
                                            <Path Data="M8,2 L8,14 M2,8 L14,8" Stroke="#F59E0B" StrokeThickness="2"/>
                                            <Path Data="M5,5 L11,11 M11,5 L5,11" Stroke="#F59E0B" StrokeThickness="1"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" Foreground="#E2E8F0"/>
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>

                    <Button Content="Metas" Style="{StaticResource SidebarButtonStyle}" Click="GoalsButton_Click">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="22" Height="22" Margin="0,0,14,0">
                                        <Canvas Width="16" Height="16">
                                            <Path Data="M2,8 L6,12 L14,4" Stroke="#8B5CF6" StrokeThickness="2"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" Foreground="#E2E8F0"/>
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>

                </StackPanel>

                <!-- Card usuário -->
                <Border Grid.Row="2" Background="#1A2340" Margin="12,0,12,16" CornerRadius="16" Padding="14">
                    <StackPanel Orientation="Horizontal">
                        <!-- Ícone de usuário (sem imagem) -->
                        <Border Width="40" Height="40" CornerRadius="20" Background="#2D4A8A">
                            <TextBlock Text="👤" FontSize="24" Foreground="White" 
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="SidebarNomeText" Text="Usuário" FontWeight="SemiBold" FontSize="18" Foreground="#F1F5F9"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </Grid>
        </Border>

        <!-- CONTEÚDO PRINCIPAL -->
        <Border Grid.Column="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Cabeçalho -->
                <Grid Grid.Row="0" Margin="60,40,60,20">
                    <TextBlock Text="Seu Perfil" FontSize="36" FontWeight="Bold"
                               Foreground="#F1F5F9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            Width="44" Height="44" Cursor="Hand" Click="FecharTela_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="brdX" Background="Transparent" CornerRadius="8">
                                    <TextBlock Text="✕" FontSize="22" FontWeight="Bold"
                                               Foreground="#F1F5F9"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="brdX" Property="Background" Value="#2D1052"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Campos -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="60,0,60,40">
                    <StackPanel>

                        <!-- Foto -->
                        <!-- Foto -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Foto do Perfil" FontSize="16" FontWeight="Bold" Foreground="#F1F5F9" Margin="0,0,0,16"/>
                                <Border Width="90" Height="90" CornerRadius="45" HorizontalAlignment="Left" >
                                    <Border.Background>
                                        <ImageBrush x:Name="FotoPerfilBrush" />
                                    </Border.Background>
                                    <TextBlock x:Name="FotoFallbackText" Text="👤" FontSize="40" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Alterar Foto" Style="{StaticResource AlterarFotoButtonStyle}" VerticalAlignment="Bottom" Click="AlterarFoto_Click"/>
                        </Grid>

                        <Rectangle Height="1" Fill="#3D1A6B" Margin="0,24,0,24"/>

                        <!-- Nome -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Nome" FontSize="16" FontWeight="Bold" Foreground="#F1F5F9" Margin="0,0,0,8"/>
                                <TextBlock x:Name="NomeVisualizacao" FontSize="15" Foreground="#CBD5E1"/>
                                <TextBox x:Name="NomeEdicao" FontSize="15" Foreground="#F1F5F9"
                                         Background="#2D1052" BorderBrush="#5B21B6" BorderThickness="1"
                                         Padding="8,6" Visibility="Collapsed" MaxWidth="400" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <Button x:Name="BtnEditarNome" Grid.Column="1" Content="Editar"
                                    Style="{StaticResource EditButtonStyle}"
                                    VerticalAlignment="Center" Click="EditarNome_Click"/>
                        </Grid>

                        <Rectangle Height="1" Fill="#3D1A6B" Margin="0,24,0,24"/>

                        <!-- Telefone -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="telefone" FontSize="16" FontWeight="Bold" Foreground="#F1F5F9" Margin="0,0,0,8"/>
                                <TextBlock x:Name="TelefoneVisualizacao" FontSize="15" Foreground="#CBD5E1"/>
                                <TextBox x:Name="TelefoneEdicao" FontSize="15" Foreground="#F1F5F9"
                                         Background="#2D1052" BorderBrush="#5B21B6" BorderThickness="1"
                                         Padding="8,6" Visibility="Collapsed" MaxWidth="400" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <Button x:Name="BtnEditarTelefone" Grid.Column="1" Content="Editar"
                                    Style="{StaticResource EditButtonStyle}"
                                    VerticalAlignment="Center" Click="EditarTelefone_Click"/>
                        </Grid>

                        <Rectangle Height="1" Fill="#3D1A6B" Margin="0,24,0,24"/>

                        <!-- Senha -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Senha" FontSize="16" FontWeight="Bold" Foreground="#F1F5F9" Margin="0,0,0,8"/>
                                <TextBlock x:Name="SenhaVisualizacao" Text="************" FontSize="15" Foreground="#CBD5E1"/>
                                <StackPanel x:Name="SenhaEdicaoPanel" Visibility="Collapsed">
                                    <TextBlock Text="Senha atual:" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                                    <PasswordBox x:Name="SenhaAtualBox" FontSize="14" Foreground="#F1F5F9"
                                                 Background="#2D1052" BorderBrush="#5B21B6" BorderThickness="1"
                                                 Padding="8,6" MaxWidth="400" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                                    <TextBlock Text="Nova senha:" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                                    <PasswordBox x:Name="SenhaNovaBox" FontSize="14" Foreground="#F1F5F9"
                                                 Background="#2D1052" BorderBrush="#5B21B6" BorderThickness="1"
                                                 Padding="8,6" MaxWidth="400" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </StackPanel>
                            <Button x:Name="BtnEditarSenha" Grid.Column="1" Content="Editar"
                                    Style="{StaticResource EditButtonStyle}"
                                    VerticalAlignment="Center" Click="EditarSenha_Click"/>
                        </Grid>

                        <Rectangle Height="1" Fill="#3D1A6B" Margin="0,24,0,16"/>

                        <!-- Feedback -->
                        <TextBlock x:Name="FeedbackText" FontSize="13"
                                   HorizontalAlignment="Center" Margin="0,0,0,16"
                                   Visibility="Collapsed"/>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

    </Grid>
</Window>
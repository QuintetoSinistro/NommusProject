<Window x:Class="NommusProject.MetasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nommus - Métricas &amp; Metas"
        Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#0A0F1E"
        WindowState="Maximized">

    <Window.Resources>

        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="14" Margin="8,4">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E2D5A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#243670"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FiltroButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="brd" Background="{TemplateBinding Background}"
                                CornerRadius="20" BorderBrush="#1E2D5A" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="brd" Property="Background" Value="#1E2D5A"/>
                                <Setter Property="Foreground" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FiltroAtivoButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1D4ED8"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="brd" Background="{TemplateBinding Background}"
                                CornerRadius="20" BorderBrush="#3B82F6" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="brd" Property="Background" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style x:Key="MetaAddButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1D4ED8"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="brd" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="brd" Property="Background" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0" Background="#0D1B3E" BorderBrush="#1E2D5A" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="20,30" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Viewbox Width="40" Height="40">
                        <Canvas Width="24" Height="24">
                            <Path Data="M3,12 L7,8 L11,14 L15,10 L19,16 L21,12" Stroke="#3B82F6" StrokeThickness="2"/>
                            <Ellipse Canvas.Left="2"  Canvas.Top="11" Width="2" Height="2" Fill="#3B82F6"/>
                            <Ellipse Canvas.Left="6"  Canvas.Top="7"  Width="2" Height="2" Fill="#3B82F6"/>
                            <Ellipse Canvas.Left="10" Canvas.Top="13" Width="2" Height="2" Fill="#3B82F6"/>
                            <Ellipse Canvas.Left="14" Canvas.Top="9"  Width="2" Height="2" Fill="#3B82F6"/>
                            <Ellipse Canvas.Left="18" Canvas.Top="15" Width="2" Height="2" Fill="#3B82F6"/>
                            <Ellipse Canvas.Left="20" Canvas.Top="11" Width="2" Height="2" Fill="#3B82F6"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="Nommus" FontSize="24" FontWeight="Bold" Foreground="#F1F5F9" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="10,20">

                    <Button Content="Finanças" Style="{StaticResource SidebarButtonStyle}" Click="FinanceButton_Click">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="22" Height="22" Margin="0,0,14,0">
                                        <Canvas Width="16" Height="16">
                                            <Path Data="M2,2 L14,2 L14,14 L2,14 Z M4,4 L12,4 L12,12 L4,12 Z M6,6 L10,6 L10,10 L6,10 Z" Fill="#3B82F6"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" Foreground="#E2E8F0"/>
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>

                    <Button Content="Cartões" Style="{StaticResource SidebarButtonStyle}" Click="CardsButton_Click">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="22" Height="22" Margin="0,0,14,0">
                                        <Canvas Width="16" Height="16">
                                            <Path Data="M2,4 L14,4 L14,12 L2,12 Z M4,6 L12,6 L12,10 L4,10 Z M6,8 L10,8" Fill="#10B981"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" Foreground="#E2E8F0"/>
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>

                    <Button Content="Despesas" Style="{StaticResource SidebarButtonStyle}" Click="ExpensesButton_Click">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="22" Height="22" Margin="0,0,14,0">
                                        <Canvas Width="16" Height="16">
                                            <Path Data="M8,2 L8,14 M2,8 L14,8" Stroke="#EF4444" StrokeThickness="2"/>
                                            <Path Data="M4,4 L12,12 M12,4 L4,12" Stroke="#EF4444" StrokeThickness="1"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" Foreground="#E2E8F0"/>
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>

                    <Button Content="Receitas" Style="{StaticResource SidebarButtonStyle}" Click="CreditsButton_Click">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="22" Height="22" Margin="0,0,14,0">
                                        <Canvas Width="16" Height="16">
                                            <Path Data="M8,2 L8,14 M2,8 L14,8" Stroke="#F59E0B" StrokeThickness="2"/>
                                            <Path Data="M5,5 L11,11 M11,5 L5,11" Stroke="#F59E0B" StrokeThickness="1"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" Foreground="#E2E8F0"/>
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>

                    <!-- Metas - destacado como ativo -->
                    <Border Background="#1E2D5A" CornerRadius="14" Margin="8,4">
                        <Button Content="Metas" Style="{StaticResource SidebarButtonStyle}" Click="GoalsButton_Click">
                            <Button.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="22" Height="22" Margin="0,0,14,0">
                                            <Canvas Width="16" Height="16">
                                                <Path Data="M2,8 L6,12 L14,4" Stroke="#3B82F6" StrokeThickness="2"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center" Foreground="#3B82F6"/>
                                    </StackPanel>
                                </DataTemplate>
                            </Button.ContentTemplate>
                        </Button>
                    </Border>

                </StackPanel>

                <!-- Card usuário -->
                <Border Grid.Row="2" Background="#1A2340" Margin="12,0,12,16" CornerRadius="16" Padding="14"
                        Cursor="Hand" MouseLeftButtonDown="UsuarioCard_Click">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="40" Height="40">
                            <Ellipse.Fill>
                                <SolidColorBrush Color="#2D4A8A"/>
                            </Ellipse.Fill>
                        </Ellipse>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="UsuarioNomeText" Text="Usuário" FontWeight="SemiBold" FontSize="16" Foreground="#F1F5F9"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </Grid>
        </Border>

        <!-- CONTEÚDO PRINCIPAL -->
        <Border Grid.Column="1" Background="#0A0F1E" Padding="30">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Cabeçalho + filtros -->
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Métricas &amp; Metas" FontSize="28" FontWeight="Bold" Foreground="#F1F5F9"/>
                            <TextBlock x:Name="SubtituloText" Text="Últimos 30 dias"
                                       FontSize="14" Foreground="#64748B" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnFiltro30" Content="30 dias" Style="{StaticResource FiltroAtivoButtonStyle}" Margin="0,0,8,0" Click="Filtro30_Click"/>
                            <Button x:Name="BtnFiltro6M" Content="6 meses" Style="{StaticResource FiltroButtonStyle}"      Margin="0,0,8,0" Click="Filtro6M_Click"/>
                            <Button x:Name="BtnFiltro1A" Content="1 ano"   Style="{StaticResource FiltroButtonStyle}"      Click="Filtro1A_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- CARDS RESUMO -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#0D2A1F" Offset="0"/>
                                    <GradientStop Color="#111827" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Background="#064E3B" CornerRadius="8" Padding="8">
                                        <TextBlock Text="↑" FontSize="16" Foreground="#10B981" FontWeight="Bold"/>
                                    </Border>
                                    <TextBlock Text="Receitas" FontSize="13" Foreground="#94A3B8" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="CardReceitaTotal" Text="R$ 0,00" FontSize="24" FontWeight="Bold" Foreground="#10B981"/>
                                <TextBlock x:Name="CardReceitaQtd"   Text="0 transações" FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#2D0A0A" Offset="0"/>
                                    <GradientStop Color="#111827" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Background="#7F1D1D" CornerRadius="8" Padding="8">
                                        <TextBlock Text="↓" FontSize="16" Foreground="#EF4444" FontWeight="Bold"/>
                                    </Border>
                                    <TextBlock Text="Despesas" FontSize="13" Foreground="#94A3B8" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="CardDespesaTotal" Text="R$ 0,00" FontSize="24" FontWeight="Bold" Foreground="#EF4444"/>
                                <TextBlock x:Name="CardDespesaQtd"   Text="0 transações" FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#0D1B3E" Offset="0"/>
                                    <GradientStop Color="#111827" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Background="#1E3A8A" CornerRadius="8" Padding="8">
                                        <TextBlock Text="=" FontSize="16" Foreground="#3B82F6" FontWeight="Bold"/>
                                    </Border>
                                    <TextBlock Text="Saldo período" FontSize="13" Foreground="#94A3B8" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="CardSaldoPeriodo" Text="R$ 0,00" FontSize="24" FontWeight="Bold" Foreground="#3B82F6"/>
                                <TextBlock Text="no período selecionado" FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3" Style="{StaticResource CardStyle}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1A0D3E" Offset="0"/>
                                    <GradientStop Color="#111827" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Background="#4C1D95" CornerRadius="8" Padding="8">
                                        <TextBlock Text="%" FontSize="16" Foreground="#8B5CF6" FontWeight="Bold"/>
                                    </Border>
                                    <TextBlock Text="Taxa economia" FontSize="13" Foreground="#94A3B8" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="CardTaxaEconomia" Text="0%" FontSize="24" FontWeight="Bold" Foreground="#8B5CF6"/>
                                <TextBlock Text="da receita guardada" FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                    </Grid>

                    <!-- GRÁFICOS -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="220"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                                    <TextBlock Text="Gastos por Mês" FontSize="16" FontWeight="Bold" Foreground="#F1F5F9"/>
                                    <TextBlock Text="Receitas vs Despesas" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="220"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                                    <TextBlock Text="Distribuição" FontSize="16" FontWeight="Bold" Foreground="#F1F5F9"/>
                                    <TextBlock Text="Receita vs Despesa" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                                </StackPanel>
                                <lvc:PieChart Grid.Row="1" x:Name="GraficoPizza"
                                              Background="Transparent" DisableAnimations="True"
                                              Hoverable="False" DataTooltip="{x:Null}"
                                              LegendLocation="Bottom" InnerRadius="40">
                                    <lvc:PieChart.ChartLegend>
                                        <lvc:DefaultLegend Foreground="White" FontSize="11"/>
                                    </lvc:PieChart.ChartLegend>
                                </lvc:PieChart>
                            </Grid>
                        </Border>

                    </Grid>

                    <!-- METAS DE ECONOMIA -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                        <StackPanel>
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Metas de Economia" FontSize="16" FontWeight="Bold" Foreground="#F1F5F9"/>
                                    <TextBlock Text="Acompanhe seu progresso" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="+ Nova Meta"
                                        Style="{StaticResource MetaAddButtonStyle}" Click="NovaMeta_Click"/>
                            </Grid>

                            <ItemsControl x:Name="ListaMetas">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#0D1B3E" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Nome}"
                                                               FontSize="14" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                                                    <TextBlock Grid.Column="1" FontSize="13" FontWeight="Bold" Foreground="#3B82F6">
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="{}{0:C} / {1:C}">
                                                                <Binding Path="Atual"/>
                                                                <Binding Path="Objetivo"/>
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </Grid>
                                                <Grid Grid.Row="1" Height="8" Margin="0,0,0,8">
                                                    <Border Background="#1E2D5A" CornerRadius="4"/>
                                                    <Border CornerRadius="4" HorizontalAlignment="Left" Width="{Binding LarguraProgresso}">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                <GradientStop Color="#3B82F6" Offset="0"/>
                                                                <GradientStop Color="#8B5CF6" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Grid.Row="2" Text="{Binding PercentualTexto}"
                                                           FontSize="11" Foreground="#64748B"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel x:Name="MetasVazioPanel" HorizontalAlignment="Center" Margin="0,20">
                                <TextBlock Text="🎯" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="Nenhuma meta criada ainda" FontSize="14" Foreground="#64748B" HorizontalAlignment="Center"/>
                                <TextBlock Text="Clique em '+ Nova Meta' para começar" FontSize="12" Foreground="#475569" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- TOP 5 GASTOS -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Top 5 — Maiores Gastos do Período"
                                       FontSize="16" FontWeight="Bold" Foreground="#F1F5F9" Margin="0,0,0,20"/>
                            <ItemsControl x:Name="ListaTopGastos">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#0D1B3E" CornerRadius="8"
                                                    Width="32" Height="32" Margin="0,0,14,0">
                                                <TextBlock Text="{Binding Posicao}" FontSize="13" FontWeight="Bold"
                                                           Foreground="#3B82F6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Descricao}" FontSize="13" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                                                <TextBlock Text="{Binding Data}" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Valor, StringFormat=R$ \{0:F2\}}"
                                                       FontSize="14" FontWeight="Bold" Foreground="#EF4444" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="TopGastosVazio" Text="Nenhuma despesa encontrada no período."
                                       FontSize="13" Foreground="#64748B" HorizontalAlignment="Center"
                                       Margin="0,10" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- OVERLAY popup usuário -->
        <Rectangle x:Name="PopupOverlay" Grid.ColumnSpan="2" Fill="Transparent"
                   Panel.ZIndex="10" Visibility="Collapsed" MouseLeftButtonDown="FecharPopup_Click"/>

        <!-- POPUP USUÁRIO -->
        <Border x:Name="UserPopupCard" Grid.Column="0" Panel.ZIndex="11" Visibility="Collapsed"
                Background="#0F1E45" BorderBrush="#2563EB" BorderThickness="1" CornerRadius="16"
                Margin="12,0,12,80" VerticalAlignment="Bottom" HorizontalAlignment="Stretch">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="24" Opacity="0.6" ShadowDepth="4"/>
            </Border.Effect>
            <StackPanel Margin="16,16,16,12">
                <TextBlock Text="Conta" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Ellipse Width="44" Height="44">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="#1E3A8A"/>
                        </Ellipse.Fill>
                        <Ellipse.Stroke>
                            <SolidColorBrush Color="#3B82F6"/>
                        </Ellipse.Stroke>
                        <Ellipse.StrokeThickness>2</Ellipse.StrokeThickness>
                    </Ellipse>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="PopupNomeText"  Text="Usuário" FontSize="14" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                        <TextBlock x:Name="PopupEmailText" Text="email@exemplo.com" FontSize="11" Foreground="#64748B"/>
                    </StackPanel>
                </StackPanel>
                <Rectangle Height="1" Fill="#1E2D5A" Margin="0,0,0,12"/>
                <Button Height="44" Margin="0,0,0,8" Cursor="Hand" Click="PopupConfiguracoes_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="brdConfig" Background="#0D1B3E" CornerRadius="10" BorderBrush="#1E3A8A" BorderThickness="1">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="14,0" VerticalAlignment="Center">
                                    <TextBlock Text="⚙" Foreground="#3B82F6" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Configurações" Foreground="#E2E8F0" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="brdConfig" Property="Background" Value="#1A2D5A"/>
                                    <Setter TargetName="brdConfig" Property="BorderBrush" Value="#3B82F6"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Height="44" Cursor="Hand" Click="PopupLogout_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="brdLogout" Background="#1F0A0A" CornerRadius="10" BorderBrush="#7F1D1D" BorderThickness="1">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="14,0" VerticalAlignment="Center">
                                    <TextBlock Text="→" Foreground="#EF4444" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Fazer Logout" Foreground="#EF4444" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="brdLogout" Property="Background" Value="#2D0F0F"/>
                                    <Setter TargetName="brdLogout" Property="BorderBrush" Value="#EF4444"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>

        <!-- POPUP NOVA META -->
        <Rectangle x:Name="NovaMetaOverlay" Grid.ColumnSpan="2" Fill="#80000000"
                   Panel.ZIndex="19" Visibility="Collapsed" MouseLeftButtonDown="FecharNovaMeta_Click"/>

        <Border x:Name="NovaMetaPopup" Grid.ColumnSpan="2" Panel.ZIndex="20" Visibility="Collapsed"
                Background="#0F1E45" BorderBrush="#2563EB" BorderThickness="1" CornerRadius="16"
                Width="420" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="30" Opacity="0.7" ShadowDepth="0"/>
            </Border.Effect>
            <StackPanel Margin="28,24,28,28">
                <Grid Margin="0,0,0,20">
                    <TextBlock Text="Nova Meta de Economia" FontSize="18" FontWeight="Bold" Foreground="#F1F5F9"/>
                    <Button HorizontalAlignment="Right" Width="30" Height="30" Cursor="Hand" Click="FecharNovaMeta_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bX" Background="Transparent" CornerRadius="6">
                                    <TextBlock Text="✕" FontSize="16" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bX" Property="Background" Value="#1E2D5A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
                <TextBlock Text="Nome da meta" FontSize="13" Foreground="#94A3B8" Margin="0,0,0,6"/>
                <TextBox x:Name="MetaNomeBox" FontSize="14" Foreground="#F1F5F9"
                         Background="#0D1B3E" BorderBrush="#1E3A8A" BorderThickness="1" Padding="10,8" Margin="0,0,0,16"/>
                <TextBlock Text="Valor objetivo (R$)" FontSize="13" Foreground="#94A3B8" Margin="0,0,0,6"/>
                <TextBox x:Name="MetaObjetivoBox" FontSize="14" Foreground="#F1F5F9"
                         Background="#0D1B3E" BorderBrush="#1E3A8A" BorderThickness="1" Padding="10,8" Margin="0,0,0,16"/>
                <TextBlock Text="Valor atual economizado (R$)" FontSize="13" Foreground="#94A3B8" Margin="0,0,0,6"/>
                <TextBox x:Name="MetaAtualBox" FontSize="14" Foreground="#F1F5F9"
                         Background="#0D1B3E" BorderBrush="#1E3A8A" BorderThickness="1" Padding="10,8" Margin="0,0,0,24"/>
                <Button Content="Criar Meta" Style="{StaticResource MetaAddButtonStyle}" Height="44" Click="CriarMeta_Click"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>
<Page x:Class="NommusProject.Views.RegisterScreen"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:NommusProject.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RegisterScreen">


    <Grid Margin="20">
        <Grid.Background>
            <LinearGradientBrush>
                <GradientStop Color="#0f132e" Offset="0.0"/>
                <GradientStop Color="#19274e" Offset="0.5"/>
                <GradientStop Color="#536d88" Offset="0.8"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Título -->
            <TextBlock Text="Register Screen" 
                       FontSize="22" 
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,20"/>

            <!-- Formulário -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
            <Border BorderBrush="white" BorderThickness="0,0,0,3">
                <PasswordBox x:Name="PasswordBox"
                            FontSize="16"
                            Foreground="White"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0,0,0,5"/>
                
            </Border>
            <Button Content="Registrar"
                        Background="#1B263B"
                        Foreground="White"
                        FontWeight="Bold"
                        Height="35"
                        Margin="0,10,0,0"
                        />
        </StackPanel>
    </Grid>
</Page>
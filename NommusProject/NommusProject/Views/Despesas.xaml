<Window x:Class="NommusProject.ExpensesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        Title="Nommus - Despesas" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        WindowState="Maximized">

    <Window.Resources>
        <!-- Styles -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="20"
                                Margin="8,4">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E293B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                BorderBrush="#334155"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                BorderBrush="#2563EB"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                BorderBrush="#DC2626"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#DC2626"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Row="0" Margin="20,30" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Viewbox Width="40" Height="40">
                        <Canvas Width="24" Height="24">
                            <Path Data="M3,12 L7,8 L11,14 L15,10 L19,16 L21,12" 
                                  Stroke="#3B82F6" StrokeThickness="2"/>
                            <Ellipse Canvas.Left="2" Canvas.Top="11" Width="2" Height="2" Fill="#3B82F6"/>
                            <Ellipse Canvas.Left="6" Canvas.Top="7" Width="2" Height="2" Fill="#3B82F6"/>
                            <Ellipse Canvas.Left="10" Canvas.Top="13" Width="2" Height="2" Fill="#3B82F6"/>
                            <Ellipse Canvas.Left="14" Canvas.Top="9" Width="2" Height="2" Fill="#3B82F6"/>
                            <Ellipse Canvas.Left="18" Canvas.Top="15" Width="2" Height="2" Fill="#3B82F6"/>
                            <Ellipse Canvas.Left="20" Canvas.Top="11" Width="2" Height="2" Fill="#3B82F6"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="Nommus" FontSize="24" FontWeight="Bold" Foreground="#F1F5F9" 
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>

                <!-- Navigation Menu -->
                <StackPanel Grid.Row="1" Margin="10,20">
                    <Button Content="Finanças" Style="{StaticResource SidebarButtonStyle}" Click="FinanceButton_Click">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="24" Height="24" Margin="0,0,12,0">
                                        <Canvas Width="16" Height="16">
                                            <Path Data="M2,2 L14,2 L14,14 L2,14 Z M4,4 L12,4 L12,12 L4,12 Z M6,6 L10,6 L10,10 L6,10 Z" 
                                                  Fill="#3B82F6"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" Foreground="#E2E8F0"/>
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>

                    <Button Content="Cartões" Style="{StaticResource SidebarButtonStyle}" Click="CardsButton_Click">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="24" Height="24" Margin="0,0,12,0">
                                        <Canvas Width="16" Height="16">
                                            <Path Data="M2,4 L14,4 L14,12 L2,12 Z M4,6 L12,6 L12,10 L4,10 Z M6,8 L10,8" 
                                                  Fill="#10B981"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" Foreground="#E2E8F0"/>
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>

                    <Button Content="Despesas" Style="{StaticResource SidebarButtonStyle}" Click="ExpensesButton_Click"
                            Background="#1E293B" Foreground="#3B82F6">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="24" Height="24" Margin="0,0,12,0">
                                        <Canvas Width="16" Height="16">
                                            <Path Data="M8,2 L8,14 M2,8 L14,8" 
                                                  Stroke="#EF4444" StrokeThickness="2"/>
                                            <Path Data="M4,4 L12,12 M12,4 L4,12" 
                                                  Stroke="#EF4444" StrokeThickness="1"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" Foreground="#3B82F6" FontWeight="Bold"/>
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>

                    <Button Content="Receitas" Style="{StaticResource SidebarButtonStyle}" Click="CreditsButton_Click">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="24" Height="24" Margin="0,0,12,0">
                                        <Canvas Width="16" Height="16">
                                            <Path Data="M8,2 L8,14 M2,8 L14,8" 
                                                  Stroke="#F59E0B" StrokeThickness="2"/>
                                            <Path Data="M5,5 L11,11 M11,5 L5,11" 
                                                  Stroke="#F59E0B" StrokeThickness="1"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" Foreground="#E2E8F0"/>
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>

                    <Button Content="Metas" Style="{StaticResource SidebarButtonStyle}" Click="GoalsButton_Click">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="24" Height="24" Margin="0,0,12,0">
                                        <Canvas Width="16" Height="16">
                                            <Path Data="M2,8 L6,12 L14,4" 
                                                  Stroke="#8B5CF6" StrokeThickness="2"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" Foreground="#E2E8F0"/>
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                </StackPanel>

                <!-- User Profile -->
                <Border Grid.Row="2" Background="#334155" Margin="16" CornerRadius="16" Padding="16">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="40" Height="40" Fill="#64748B"/>
                        <StackPanel Margin="12,0,0,0">
                            <TextBlock x:Name="UsuarioNomeText" Text="Usuário" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                            <TextBlock x:Name="UsuarioTipoText" Text="Premium" Foreground="#3B82F6" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content - Área de Gastos -->
        <Border Grid.Column="1" Background="#0F172A" Padding="30">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Background="#1E293B" CornerRadius="12" Padding="20" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Gerenciar Gastos" 
                                   FontSize="24" FontWeight="Bold" Foreground="#F1F5F9"
                                   VerticalAlignment="Center"/>

                        <Button Grid.Column="1" Content="Voltar para Dashboard" 
                                Style="{StaticResource ActionButtonStyle}"
                                Click="BackToDashboard_Click"/>
                    </Grid>
                </Border>

                <!-- Conteúdo Principal -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="400"/>
                    </Grid.ColumnDefinitions>

                    <!-- Lista de Gastos -->
                    <Border Grid.Column="0" Background="#1E293B" CornerRadius="12" Padding="20" Margin="0,0,15,0">
                        <StackPanel>
                            <TextBlock Text="Gastos Registrados" 
                   FontSize="18" FontWeight="SemiBold" Foreground="#F1F5F9"
                   Margin="0,0,0,20"/>

                            <!-- Lista de gastos FUNCIONAL -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Height="300">
                                <ItemsControl x:Name="DespesasItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#0F172A" CornerRadius="8" Padding="15" Margin="0,0,0,10"
                                BorderBrush="#334155" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding DescricaoTransacao}" 
                                               Foreground="#F1F5F9" FontWeight="SemiBold" FontSize="14"/>
                                                        <TextBlock Text="{Binding CategoriaId}" 
                                               Foreground="#94A3B8" FontSize="12" Margin="0,5,0,0"/>
                                                        <TextBlock Text="{Binding DataTransacao, StringFormat='dd/MM/yyyy'}" 
                                               Foreground="#64748B" FontSize="11" Margin="0,2,0,0"/>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="1" Text="{Binding ValorTransacao, StringFormat='R$ {0:F2}'}" 
                                           Foreground="#EF4444" FontWeight="Bold" FontSize="16"
                                           VerticalAlignment="Center" Margin="0,0,15,0"/>

                                                    <Button Grid.Column="2" Content="✕" 
                                        Background="Transparent" Foreground="#EF4444" FontSize="12"
                                        Width="25" Height="25" Padding="0"
                                        Click="RemoverDespesa_Click"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Ações em lote -->
                            <StackPanel Orientation="Horizontal" Margin="0,20,0,0" HorizontalAlignment="Center">
                                <Button Content="Exportar Relatório" Style="{StaticResource ActionButtonStyle}" Margin="0,0,10,0" Click="ExportReport_Click"/>
                                <Button Content="Filtrar Gastos" Style="{StaticResource ActionButtonStyle}" Margin="0,0,10,0" Click="FilterExpenses_Click"/>
                                <Button Content="Limpar Todos" Style="{StaticResource DangerButtonStyle}" Click="ClearAll_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Formulário de Novo Gasto -->
                    <Border Grid.Column="1" Background="#1E293B" CornerRadius="12" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Adicionar Novo Gasto" 
                                       FontSize="18" FontWeight="SemiBold" Foreground="#F1F5F9"
                                       Margin="0,0,0,20"/>

                            <!-- Campos do formulário -->
                            <StackPanel Margin="0,0,0,15">
                                <TextBlock Text="Descrição" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,5"/>
                                <TextBox x:Name="DescriptionTextBox" Background="#0F172A" Foreground="White" BorderThickness="0" Padding="10" FontSize="14"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,15">
                                <TextBlock Text="Valor (R$)" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,5"/>
                                <TextBox x:Name="ValueTextBox" Background="#0F172A" Foreground="White" BorderThickness="0" Padding="10" FontSize="14" Text="0,00"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,15">
                                <TextBlock Text="Categoria" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,5"/>
                                <ComboBox x:Name="CategoryComboBox" Background="#0F172A" Foreground="black" BorderThickness="0" Padding="10" FontSize="14">
                                    <ComboBoxItem Content="Alimentação"/>
                                    <ComboBoxItem Content="Transporte"/>
                                    <ComboBoxItem Content="Moradia"/>
                                    <ComboBoxItem Content="Lazer"/>
                                    <ComboBoxItem Content="Saúde"/>
                                    <ComboBoxItem Content="Educação"/>
                                    <ComboBoxItem Content="Outros"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,15">
                                <TextBlock Text="Data" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,5"/>
                                <TextBox x:Name="DateTextBox" Background="#0F172A" Foreground="White" BorderThickness="0" Padding="10" FontSize="14" 
                                         Text="{Binding Path=., Source={x:Static system:DateTime.Today}, StringFormat='dd/MM/yyyy'}"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="Tipo de Gasto" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,5"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="FixedRadio" Content="Fixo" Foreground="White" Margin="0,0,15,0" IsChecked="True"/>
                                    <RadioButton x:Name="VariableRadio" Content="Variável" Foreground="White" Margin="0,0,15,0"/>
                                    <RadioButton x:Name="EmergencyRadio" Content="Emergência" Foreground="White"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Botões de ação -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="Adicionar Gasto" Style="{StaticResource FormButtonStyle}" Margin="0,0,10,0"
                                        Click="AddExpense_Click"/>
                                <Button Content="Planejar Futuro" Style="{StaticResource ActionButtonStyle}"
                                        Click="PlanFutureExpense_Click"/>
                            </StackPanel>

                            <!-- Planejamento futuro -->
                            <Border x:Name="FuturePlanningPanel" Background="#0F172A" CornerRadius="8" Padding="15" 
                                    Margin="0,20,0,0" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="Planejar Gasto Futuro" FontWeight="SemiBold" Foreground="#F1F5F9" Margin="0,0,0,10"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="FutureValueTextBox" Background="#1E293B" Foreground="White" BorderThickness="0" Padding="10" 
                                                 FontSize="14" Width="120" Text="0,00" Margin="0,0,10,0"/>
                                        <TextBox x:Name="FutureDateTextBox" Background="#1E293B" Foreground="White" BorderThickness="0" Padding="10" 
                                                 FontSize="14" Width="120" Text="dd/MM/aaaa"/>
                                        <Button Content="Salvar" Style="{StaticResource FormButtonStyle}" Margin="10,0,0,0" Click="SaveFuturePlan_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
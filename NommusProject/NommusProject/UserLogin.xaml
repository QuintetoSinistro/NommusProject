<Window x:Class="NommusProject.UserLogin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NommusProject"
        mc:Ignorable="d"
        Title="Login" Height="450" Width="800">
    <Grid Margin="0,-15,0,0">
        <Grid.Background>
            <LinearGradientBrush>
                <GradientStop Color="#0f132e" Offset="0.0"/>
                <GradientStop Color="#19274e" Offset="0.5"/>
                <GradientStop Color="#536d88" Offset="0.8"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Border Background="#1affffff" Padding="20" Width="392" Height="309" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="350,0,0,0">
            <Grid>
                <!-- Campo de usuário com underline e placeholder -->
                <Border BorderBrush="White" BorderThickness="0,0,0,3" Margin="20,33,20,203">
                    <Grid>
                        <TextBox x:Name="UsernameTextBox"
                 Background="Transparent"
                 BorderThickness="0"
                 Foreground="White"
                 FontSize="30"
                 Height="28"
                 VerticalContentAlignment="Center"
                 GotFocus="UsernameTextBox_GotFocus"
                 LostFocus="UsernameTextBox_LostFocus"/>
                        <TextBlock x:Name="UsernamePlaceholder"
                   Text="Usuário"
                   Foreground="#88FFFFFF"
                   VerticalAlignment="Center"
                   Margin="5,0,0,0"
                   IsHitTestVisible="False"
                   Visibility="Visible"/>
                    </Grid>
                </Border>

                <!-- Campo de senha com underline -->
                <Border BorderBrush="White"
        BorderThickness="0,0,0,3"
        Margin="20,95,20,128"
        Padding="0,0,0,4">
                    <PasswordBox x:Name="PasswordBox"
                 Background="Transparent"
                 BorderThickness="0"
                 Foreground="white"
                 FontSize="16"
                 Height="28"/>
                </Border>

                <Button Content="Acessar" FontSize="20" FontWeight="Bold"  VerticalContentAlignment="Center" Width="146" Height="39" HorizontalAlignment="Center" Background="#FFCECECE" Foreground="#101547" Margin="0,230,0,0" >
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>

                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>
        <Border Background="#101547"  Padding="20" Width="276" Height="305" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="74,70,0,0">
            <StackPanel>

                <TextBlock Text="Login"  Foreground="White"  FontSize="35" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center" RenderTransformOrigin="1.336,0.581"/>
                <Line X1="0" Y1="0" X2="250" Y2="0" Stroke="White" StrokeThickness="4" Margin="0,0,0,10" />
                <TextBlock Text="Eai!" FontFamily="Consolas"  Foreground="White"  FontSize="45" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                <TextBlock Text="Bem-Vindo" FontFamily="Consolas"  Foreground="White"  FontSize="45" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                <TextBlock Text="Devolta!" FontFamily="Consolas"  Foreground="White"  FontSize="45"  Margin="0,0,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>

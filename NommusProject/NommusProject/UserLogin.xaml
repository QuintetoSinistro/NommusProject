<Window x:Class="NommusProject.UserLogin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NommusProject"
        mc:Ignorable="d"
        Title="Login" Height="450" Width="800">
    <Grid Margin="0,-15,0,0"> 
        <Grid.Background>
            <LinearGradientBrush>
                <GradientStop Color="#0f132e" Offset="0.0"/>
                <GradientStop Color="#19274e" Offset="0.5"/>
                <GradientStop Color="#536d88" Offset="0.8"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Border Background="#CCFFFFFF" CornerRadius="10" Padding="20" Width="350" Height="300" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
                <TextBlock Text="User Login" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>
                <TextBlock Text="Username:" FontSize="14" Margin="0,0,0,5"/>
                <TextBox x:Name="UsernameTextBox" Height="30" Margin="0,0,0,15"/>
                <TextBlock Text="Password:" FontSize="14" Margin="0,0,0,5"/>
                <PasswordBox x:Name="PasswordBox" Height="30" Margin="0,0,0,20"/>
                <Button Content="Login" Width="100" Height="30" HorizontalAlignment="Center">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
